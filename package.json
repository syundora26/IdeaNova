{
  "name": "ideanova-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode corporate",
    "build": "tsc --noEmit && vite build --mode corporate && vite build --mode cosmetics",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "node tests/separation-ui.cjs",
    "test:visual": "node tests/separation-ui.cjs",
    "test:a11y": "node tests/separation-ui.cjs",
    "test:admin": "node tests/admin-ui.cjs",
    "dev:corporate": "vite --mode corporate",
    "dev:cosmetics": "vite --mode cosmetics",
    "dev:service": "node server/demo.mjs",
    "dev:all": "node server/start.mjs",
    "build:corporate": "tsc --noEmit && vite build --mode corporate",
    "build:cosmetics": "tsc --noEmit && vite build --mode cosmetics",
    "build:preview": "tsc --noEmit && vite build --mode preview-corporate && vite build --mode preview-cosmetics",
    "test:separation": "node tests/separation-ui.cjs",
    "test:service": "node tests/separation-service.cjs",
    "test:recovery": "node tests/recovery-ui.cjs",
    "test:refresh": "node tests/shared-refresh-ui.cjs",
    "test:build": "node tests/build-config.cjs && node tests/build-smoke.cjs",
    "test:corporate": "node tests/reference-recreation.cjs",
    "test:polish": "node tests/reference-finish.cjs",
    "test:components": "node tests/component-props.cjs && node tests/mobile-type-check.cjs",
    "test:layout": "node tests/reference-finish.cjs",
    "test:seams": "node tests/seam-repair.cjs",
    "test:lower": "node tests/lower-finish.cjs",
    "build:share": "tsc --noEmit && vite build --config vite.share.config.ts --mode share-corporate && vite build --config vite.share.config.ts --mode share-cosmetics && node scripts/finish-share.cjs",
    "test:share": "node tests/share-preview.cjs",
    "preview:share": "node scripts/serve-share.cjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.6",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.2.6",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "gsap": "^3.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "lighthouse": "^13.4.1",
    "sharp": "^0.34.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
